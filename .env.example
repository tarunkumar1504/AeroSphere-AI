# AeroSphere AI Environment Configuration
# Provide Google Gemini API Key for dynamic GenAI routines, IAQ advisor, and voice companion
# Leave empty to utilize high-precision domain-grounded deterministic fallback engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional: Custom data persistence directory (defaults to ./data)
AEROSPHERE_DATA_DIR=

# Node Environment
NODE_ENV=development
